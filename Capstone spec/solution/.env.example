# Backend env vars. Copy to .env (and gitignore it) or export in your shell.

# --- Database ---
ORACLE_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1
ORACLE_USER=bankapp
ORACLE_PASSWORD=changeme

# --- Google OAuth ---
# The OAuth 2.0 Client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Kafka ---
# Provided by your instructor.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Payment Processor (WireMock in dev) ---
PAYMENT_PROCESSOR_URL=http://localhost:8089
PAYMENT_PROCESSOR_API_KEY=dev-only-not-secret

# --- CORS / SPA origin ---
SPA_ORIGIN=http://localhost:5173
