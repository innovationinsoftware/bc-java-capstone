# Backend env vars. Copy to .env and fill in. .env is gitignored.

# --- Database (Resource Server) ---
ORACLE_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1
ORACLE_USER=bankapp
ORACLE_PASSWORD=changeme

# --- Authorization Server URL (used by BFF and Resource Server) ---
# Defaults to the in-scaffold mock-auth on localhost:9000.
AUTH_SERVER_URL=http://localhost:9000

# --- BFF OAuth client credentials ---
# These match the spa-client registered in mock-auth's AuthorizationServerConfig.
# In real deployments, OAUTH_CLIENT_SECRET would come from a secret manager.
OAUTH_CLIENT_ID=spa-client
OAUTH_CLIENT_SECRET=spa-secret

# --- Resource Server URL (used by BFF) ---
RESOURCE_SERVER_URL=http://localhost:8081

# --- Audience (used by Resource Server JwtDecoder) ---
# Should match the BFF's client_id.
OAUTH_AUDIENCE=spa-client

# --- Kafka ---
# Provided by your instructor.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Payment Processor (WireMock in dev) ---
PAYMENT_PROCESSOR_URL=http://localhost:8089
PAYMENT_PROCESSOR_API_KEY=dev-only-not-secret
